<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The side-by-side manifest.

  Without the Common-Controls 6.0 dependency below, comctl32 hands back the
  pre-XP controls and the window renders in the Windows 95 style no matter
  what this app paints: no themed combo box, no rounded trackbar, no
  ClearType. It is the one file that has to exist for any of the rest of the
  styling to be visible, and it has to be *embedded*: an external
  .exe.manifest would not survive the "unzip it and run it" promise.

  The DPI declarations are here rather than only in code because a process
  that opts in at runtime has already created its first window by then; the
  manifest settles it before any window exists.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="io.github.SergeGris.WhiteScreen"
      version="1.0.0.0"/>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"/>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- Nothing here needs elevation, and a colour test tool that asked
             for it would be a tool nobody runs. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Declaring it is what lets GetVersion and the
           DWM backdrop attributes report the truth rather than Windows 8. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>
</assembly>
