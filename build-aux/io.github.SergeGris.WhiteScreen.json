{
  "id": "io.github.SergeGris.WhiteScreen",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "whitescreen",
  "finish-args": [
    "--socket=wayland",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib64/pkgconfig",
    "/lib/girepository-1.0",
    "/lib64/girepository-1.0",
    "/share/gir-1.0",
    "/share/vala",
    "/rust",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "rust-toolchain",
      "buildsystem": "simple",
      "build-options": {
        "build-args": [
          "--share=network"
        ],
        "env": {
          "RUSTUP_HOME": "/app/rust/rustup",
          "CARGO_HOME": "/app/rust/cargo"
        }
      },
      "build-commands": [
        "if command -v curl >/dev/null 2>&1; then curl --proto '=https' --tlsv1.2 -sSfL https://sh.rustup.rs -o rustup-init.sh; else wget -O rustup-init.sh https://sh.rustup.rs; fi",
        "sh rustup-init.sh -y --no-modify-path --profile minimal --default-toolchain stable",
        "/app/rust/cargo/bin/rustc --version"
      ]
    },
    {
      "name": "gtk4-layer-shell",
      "buildsystem": "meson",
      "config-opts": [
        "-Dexamples=false",
        "-Ddocs=false",
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/wmww/gtk4-layer-shell.git",
          "tag": "v1.3.0"
        }
      ]
    },
    {
      "name": "whitescreen",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbuildtype=release",
        "-Dgamma=true"
      ],
      "build-options": {
        "build-args": [
          "--share=network"
        ],
        "append-path": "/app/rust/cargo/bin",
        "env": {
          "RUSTUP_HOME": "/app/rust/rustup",
          "CARGO_HOME": "/run/build/whitescreen/cargo"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": "../"
        }
      ]
    }
  ]
}
